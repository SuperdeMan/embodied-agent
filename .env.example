# embodied-agent environment template (LLM + audio providers + observability).
# Copy to .env and fill what you use; every value here is empty on purpose.
# NEVER copy car-agent's .env (it contains live keys); S2S vars arrive with the voice upgrade.

# --- LLM core (generic OpenAI-compatible endpoint or Anthropic) ---
LLM_PROVIDER=            # mock | anthropic | minimax | deepseek | qwen | mimo (empty -> mock)
LLM_API_KEY=
LLM_BASE_URL=
LLM_AUTH_STYLE=          # bearer (default) | x-api-key
LLM_MODEL_PRIMARY=
LLM_MODEL_FAST=
LLM_DISABLE_THINKING=    # 1 to disable provider thinking by default

# --- HTTP budgets (seconds; sensible defaults built in) ---
LLM_HTTP_CONNECT_S=
LLM_HTTP_READ_CAP_S=
LLM_STREAM_STALL_S=

# --- Vendor-specific (used when LLM_PROVIDER selects them) ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_LLM_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL_PRIMARY=
DEEPSEEK_MODEL_FAST=
DASHSCOPE_LLM_KEY=       # Qwen (DashScope)
DASHSCOPE_ASR_KEY=       # honored as DashScope credential fallback (name kept from source)
QWEN_BASE_URL=
QWEN_MODEL_PRIMARY=
QWEN_MODEL_FAST=

# --- Embeddings ---
LLM_EMBED_URL=
LLM_EMBED_MODEL=
LLM_EMBED_API_KEY=
LLM_EMBED_AUTH_STYLE=
LLM_EMBED_DIMENSIONS=
LLM_EMBED_READ_CAP_S=

# --- Vision (planner-side scene description, wired in M1) ---
VISION_MODEL=
VISION_MODEL_FALLBACK=

# --- Voice: ASR (empty -> mock; console works keyless with placeholder text) ---
ASR_PROVIDER=            # mimo | mock
ASR_MODEL=
ASR_STREAM_PROVIDER=     # qwen | fun | mimo (streaming path, off when empty)
ASR_STREAM_MODEL=
DASHSCOPE_ASR_KEY=
DASHSCOPE_ASR_WS_URL=
DASHSCOPE_ASR_INFERENCE_WS_URL=

# --- Voice: TTS (empty -> console falls back to silent mock stream) ---
TTS_PROVIDER=
TTS_STREAM_PROVIDER=     # cosyvoice | qwen | mimo | minimax | mock
TTS_STREAM_MODEL=
TTS_INSTRUCT_DEFAULT=
TTS_SPEED_DEFAULT=
DASHSCOPE_TTS_REALTIME_WS_URL=
DASHSCOPE_TTS_INFERENCE_WS_URL=
MIMO_AUDIO_BASE_URL=
MINIMAX_TTS_MODEL=
MINIMAX_TTS_VOICE=
MINIMAX_T2A_URL=

# --- Observability ---
OBS_DIR=                 # event sink dir, default outputs/obs
OBS_STDOUT=              # 1 -> also print events to stdout
LOG_FILE=                # optional structured log file

# --- Test/CI guards ---
REQUIRE_REAL_PROVIDERS=  # 1 -> fail instead of silently falling back to mock
REQUIRE_REAL_EXEMPT=
LLM_MOCK_DELAY_MS=       # test hook: artificial mock latency
